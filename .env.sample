# Copy to .env and fill in. `.env` is gitignored and excluded from the Docker
# image; compose reads it at container start.
#
# Only AGENT_FILESYSTEM_ROOT and DEEP_SEEK_API_KEY are needed to run natively —
# everything else has a working default, and compose sets the Docker ones itself.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The one directory the agent's filesystem and shell tools may touch. No default
# on purpose: a fallback would silently expose a whole home directory. Anything
# in here is readable and writable by the model, so scope it deliberately.
AGENT_FILESYSTEM_ROOT=/Users/you/agent-workspace

# Model provider. DeepSeek is the default; set the Anthropic key too if you
# switch the default model in Settings to a Claude one.
DEEP_SEEK_API_KEY=
ANTHROPIC_API_KEY=

# HTTP Basic auth for the web server and the UI it serves. Optional locally —
# unset means no auth, and the server says so on boot. Required when
# NODE_ENV=production, where it refuses to start without both, because the API
# exposes an agent that can run shell commands.
LOGIN_USER=admin
LOGIN_PASSWORD=

# ---------------------------------------------------------------------------
# Data stores — defaults suit a local mongod and redis
# ---------------------------------------------------------------------------

# MONGODB_URI=mongodb://127.0.0.1:27017/my-mcp-server
# To share the Docker database instead, publish its port and add
# directConnection — the replica set advertises itself as `mongo:27017`, which
# won't resolve from the host:
# MONGODB_URI=mongodb://127.0.0.1:27017/my-mcp-server?directConnection=true

# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------

# PORT=8080                                   # host server (API + built UI)
# APP_MCP_PORT=8000                           # this project's own MCP server
# APP_MCP_URL=http://localhost:8000/mcp       # where the agent looks for it
# START_APP_MCP=false                         # skip the in-process copy; set in Docker
# MCP_ALLOWED_HOSTS=app-mcp                   # Host-header allowlist; needed in Docker
# SEARXNG_URL=http://localhost:8888           # `npm run search:up`
# CHROME_URL=http://127.0.0.1:9222            # a Chrome already serving DevTools
# AGENT_CWD=                                  # working dir for shell commands
# LLM_TIMEOUT_MS=600000                       # ceiling on one model call (10 min)

# Optional: Brevo email tools.
BREVO_MCP_TOKEN=

# ---------------------------------------------------------------------------
# Docker only — read by docker-compose.yml, not by the app
# ---------------------------------------------------------------------------

# Cron schedules fire in container time. Set this or a "0 9 * * 1" task runs at
# 09:00 UTC rather than 09:00 local.
# TZ=Europe/London

# SERVER_PORT=8080                            # host port for the UI; change if 8080 is taken
# SEARXNG_PORT=8888                          # host port; also used for SEARXNG_BASE_URL
# SEARXNG_SECRET=                             # session key; a fixed dev value is fine locally
# CHROME_SCREEN=1920x1080x24
# CHROME_USER_AGENT=                          # unset = headful Chromium's real UA, which is what you want
# CHROME_ENABLE_VNC=false                     # watch the browser; unauthenticated, localhost only
# CHROME_VNC_PORT=5900

# Vite dev server only.
# AGENT_URL=http://localhost:8080             # proxy target for /api
