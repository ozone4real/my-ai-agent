{
  "name": "my-mcp-server",
  "type": "module",
  "version": "1.0.0",
  "description": "MCP server: my-mcp-server",
  "author": "",
  "license": "MIT",
  "keywords": [
    "mcp",
    "server",
    "starter",
    "tools",
    "resources",
    "prompts",
    "uiresource",
    "ui",
    "react",
    "widgets",
    "mcp-ui",
    "apps-sdk"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "mcp-use build",
    "dev": "mcp-use dev",
    "app-mcp": "tsx watch --env-file-if-exists=.env mcp_servers/serve.ts",
    "worker": "tsx --env-file-if-exists=.env host/server/workers/index.ts",
    "typecheck:mcp": "tsc -p tsconfig.node.json",
    "web": "vite host",
    "web:server": "tsx watch --env-file-if-exists=.env host/server/index.ts",
    "console": "tsx host/server/console.ts",
    "web:build": "vite build host",
    "web:preview": "vite preview host",
    "workers": "tsx watch --env-file-if-exists=.env host/server/workers/index.ts",
    "search:up": "docker compose up -d searxng",
    "search:down": "docker compose stop searxng",
    "search:logs": "docker compose logs -f searxng",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "postinstall": "mcp-use typecheck || exit 0"
  },
  "engines": {
    "node": ">=23.11.1"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.4",
    "@langchain/deepseek": "^1.1.5",
    "@mcp-use/agent": "^2.0.0",
    "@mcp-use/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/apps-sdk-ui": "^0.2.1",
    "bullmq": "^6.0.8",
    "inflection": "^3.0.2",
    "ioredis": "^6.0.0",
    "langchain": "^1.5.3",
    "mcp-use": "^2.0.4",
    "mongoose": "^9.9.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "tailwindcss": "^4.2.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "express": "^5.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
